_

642
00:50:09.793 --> 00:50:11.458
_

643
00:50:18.163 --> 00:50:19.667
(thundering)

644
00:50:26.580 --> 00:50:27.827
(roars)

645
00:50:48.883 --> 00:50:50.643
(distant growling)

646
00:50:54.580 --> 00:50:55.828
(roars)

647
00:51:01.844 --> 00:51:04.083
(thundering)

648
00:51:19.988 --> 00:51:21.843
(Aemond laughs)

649
00:51:21.939 --> 00:51:23.891
(Vhagar roars)

650
00:51:25.203 --> 00:51:27.731
(intense music playing)

651
00:51:31.764 --> 00:51:34.370
- (grunts)
- (roars)

652
00:51:34.451 --> 00:51:36.243
(Aemond speaking High Valyrian)

653
00:51:39.059 --> 00:51:41.972
(roars)

654
00:51:42.868 --> 00:51:45.171
♪ ♪

655
00:51:45.267 --> 00:51:46.802
_

656
00:51:47.732 --> 00:51:49.459
(grunts)

657
00:51:54.579 --> 00:51:57.491
(grunts)

658
00:51:59.444 --> 00:52:00.979
(laughing)

659
00:52:04.179 --> 00:52:07.091
(roars)

660
00:52:09.267 --> 00:52:10.883
Ugh!

661
00:52:10.964 --> 00:52:12.243
(roars)

662
00:52:18.067 --> 00:52:19.252
(roars)

663
00:52:21.747 --> 00:52:23.700
♪ ♪

664
00:52:26.099 --> 00:52:27.667
(thundering)

665
00:52:32.963 --> 00:52:34.148
(laughs)

666
00:52:37.003 --> 00:52:39.603
_

667
00:52:40.823 --> 00:52:42.262
_

668
00:52:46.159 --> 00:52:49.903
- (roars)
- No. no. no. no. no! No. Vhagar! No!

669
00:52:49.999 --> 00:52:51.102
(shouting command)

670
00:52:51.183 --> 00:52:54.031
Serve me. Vhagar! No!
(speaks High Valyrian)

671
00:53:03.759 --> 00:53:05.327
(screeches)

672
00:53:08.911 --> 00:53:09.967
(breathing heavily)

673
00:53:20.103 --> 00:53:24.043
Aemond: Vhagar! No! No...

674
00:53:24.053 --> 00:53:25.493
(roars)

675
00:53:31.752 --> 00:53:35.240
