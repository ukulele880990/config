981
01:07:14.013 --> 01:07:15.714
(groans)

982
01:07:17.916 --> 01:07:19.651
(grunts softly)

983
01:07:22.121 --> 01:07:23.822
(breathes sharply)

984
01:07:30.029 --> 01:07:31.597
(pained grunt)

985
01:07:34.600 --> 01:07:36.535
(breathing sharply)

986
01:07:52.051 --> 01:07:53.986
(flares popping and sizzling
in distance)

987
01:08:08.067 --> 01:08:10.002
♪ ♪

988
01:08:28.220 --> 01:08:30.155
(flare popping and sizzling)

989
01:08:38.163 --> 01:08:40.132
(flare popping and sizzling)

990
01:08:49.741 --> 01:08:51.975
(gunshot in distance)

991
01:08:51.977 --> 01:08:54.010
- (gunshot)
- (grunts)

992
01:08:54.012 --> 01:08:56.913
(man shouting in German
in distance)

993
01:08:56.915 --> 01:08:58.884
(gunfire continues)

994
01:09:04.923 --> 01:09:06.892
(flare popping and sizzling)

995
01:09:12.764 --> 01:09:14.733
(flare sizzling)

996
01:09:28.814 --> 01:09:30.782
(flares popping and sizzling)

997
01:09:33.118 --> 01:09:35.053
